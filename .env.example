# Каталог форм; по умолчанию forms.json, если есть, иначе forms.example.json
FORM_ROUTER_CATALOG=

# Разрешить страницу на другом домене (например, вики), пусто — без CORS
FORM_ROUTER_CORS_ORIGIN=

# Брать IP клиента из X-Forwarded-For (включать только за своим reverse proxy)
FORM_ROUTER_TRUST_PROXY=false
FORM_ROUTER_RATE_LIMIT=30

# LLM-фолбэк: любой OpenAI-совместимый API. Без ключа работают только правила.
FORM_ROUTER_LLM=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FORM_ROUTER_LLM_TIMEOUT_SEC=15
